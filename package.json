{
  "name": "@squaresdk/solana-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "openapi:lint": "redocly lint",
    "openapi:docs": "redocly build-docs square -o dist/api/index.html",
    "contract:check": "pnpm --filter @squaresdk/solana-types gen:check && pnpm --filter @squaresdk/solana-sdk gen:check",
    "license:check": "node scripts/license/pack-files.mjs --check && node scripts/license/inventory.mjs --check",
    "license:write": "node scripts/license/pack-files.mjs --write && node scripts/license/inventory.mjs --write",
    "secrets:scan": "node scripts/security/gitleaks.mjs history",
    "format": "prettier --write .",
    "check:names": "node scripts/check-package-names.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "node scripts/hooks/install.mjs"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@changesets/cli": "^3.0.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.10",
    "@prometheus-io/lezer-promql": "^0.313.4",
    "@redocly/cli": "^2.57.0",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "@squaresdk/solana-config": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
