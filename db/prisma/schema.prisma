// Square tek veritabanı (BE-04). Tasarım ve kararlar: docs/design/data-model.md.
//
// Zincir kaynak-gerçektir. Program hesaplarının tabloları (ayna tablolar) indexer'ın (BE-14)
// zincirden kurduğu, yeniden üretilebilir görünümlerdir; API bu tablolardan okur ama hiçbir
// servis bir ayna tabloya zincirde karşılığı olmayan bir değer yazmaz.
//
// Kodlama kuralları:
// - Ayna tabloların `account` sütunu, hesabın IDL JSON kodlamasıdır (docs/design/api-sdk-contract.md §3)
//   ve API'nin `account` alanına aynen gider. Diğer sütunlar filtre / sıralama için ondan çıkarılır.
// - Adres: base58, VARCHAR(44). 32 bayt hash / commitment: küçük harf hex, CHAR(64).
// - u64: NUMERIC(20, 0). Zincirden gelen zamanlar (unix saniyesi, i64): BIGINT.
//   Veritabanının kendi zamanları (indexedAt, createdAt …): TIMESTAMPTZ.
// - Enum değerleri JSON kodlamasıyla aynıdır (camelCase); A2A enum'ları ProtoJSON adlarıyladır (TASK_STATE_*, ROLE_*).
// - Ayna tablolar arasında yabancı anahtar yoktur: hesapları anlık görüntüden (getProgramAccounts)
//   dolduran bir backfill sırasız gelebilir; bütünlüğü zincir sağlar.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- referans ve indexer durumu

enum ProgramName {
  registry
  policy
  verifier
  escrow
}

/// Square programları; seed `idl/*.json`'dan doldurur (adres ve sözleşme sürümü).
model Program {
  name       ProgramName    @id
  programId  String         @unique @map("program_id") @db.VarChar(44)
  /// IDL `metadata.version`.
  idlVersion String         @map("idl_version") @db.Text
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cursor     IndexerCursor?

  @@map("programs")
}

/// Indexer'ın program başına kaldığı yer (BE-14).
model IndexerCursor {
  program       ProgramName @id
  lastSlot      BigInt      @map("last_slot")
  lastSignature String      @map("last_signature") @db.VarChar(88)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  programRef    Program     @relation(fields: [program], references: [name], onDelete: Cascade)

  @@map("indexer_cursors")
}

/// Ham program event'leri (`IndexedEvent`, API `/v1/events`). Yalnızca kesinleşmiş (finalized)
/// tx'lerden yazılır; böylece fork geri alımı gerekmez.
model ChainEvent {
  id               BigInt      @id @default(autoincrement())
  signature        String      @db.VarChar(88)
  slot             BigInt
  blockTime        BigInt?     @map("block_time")
  instructionIndex Int         @map("instruction_index")
  eventIndex       Int         @map("event_index")
  program          ProgramName
  /// IDL event adı (ör. `JobCreated`).
  name             String      @db.Text
  /// Event bir job'a aitse job adresi (`/v1/events?job=`).
  job              String?     @db.VarChar(44)
  /// `ProgramEventPayload` JSON'u.
  payload          Json
  indexedAt        DateTime    @default(now()) @map("indexed_at") @db.Timestamptz(3)

  @@unique([signature, instructionIndex, eventIndex])
  @@index([slot])
  @@index([program, name, slot])
  @@index([job, slot])
  @@map("chain_events")
}

// ---------------------------------------------------------------- square_policy (ayna)

model Institution {
  address       String   @id @db.VarChar(44)
  ownerKey      String   @map("owner_key") @db.VarChar(44)
  /// Bağlı Squads vault'u (set_institution_multisig); yoksa null.
  multisigVault String?  @map("multisig_vault") @db.VarChar(44)
  name          String   @db.Text
  account       Json
  slot          BigInt
  indexedAt     DateTime @map("indexed_at") @db.Timestamptz(3)

  @@index([ownerKey])
  @@index([multisigVault])
  @@map("institutions")
}

model Policy {
  address     String   @id @db.VarChar(44)
  institution String   @db.VarChar(44)
  policyId    String   @map("policy_id") @db.Char(64)
  version     Int
  active      Boolean
  account     Json
  slot        BigInt
  indexedAt   DateTime @map("indexed_at") @db.Timestamptz(3)

  @@unique([institution, policyId])
  @@index([institution, active])
  @@map("policies")
}

/// Politikanın herkese açık meta verisi (`PolicyMeta`). Kurallar ve salt asla burada tutulmaz;
/// zincirde yalnızca commitment vardır.
model PolicyMeta {
  policy      String   @id @db.VarChar(44)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(2000)
  labels      String[] @db.VarChar(40)
  /// Yazan cüzdan (kurumun o anki yetkilisi).
  updatedBy   String   @map("updated_by") @db.VarChar(44)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("policy_metas")
}

// ---------------------------------------------------------------- square_registry (ayna)

enum AgentStatus {
  active
  inactive
  deregistered
}

model Agent {
  /// AgentRecord PDA'sı.
  address       String      @id @db.VarChar(44)
  creator       String      @db.VarChar(44)
  owner         String      @db.VarChar(44)
  wallet        String      @db.VarChar(44)
  agentId       String      @map("agent_id") @db.Text
  status        AgentStatus
  agentCardUri  String      @map("agent_card_uri") @db.Text
  agentCardHash String      @map("agent_card_hash") @db.Char(64)
  account       Json
  slot          BigInt
  indexedAt     DateTime    @map("indexed_at") @db.Timestamptz(3)

  @@unique([creator, agentId])
  @@index([owner])
  @@index([wallet])
  @@index([status])
  @@map("agents")
}

enum AgentCardSource {
  /// API'nin barındırdığı kart (`putAgentCard`).
  hosted
  /// `agentCardUri`'den indirilen kart.
  fetched
}

/// Agent card önbelleği. Kayıt sahibi kartı zincir kaydından önce yükleyebilir (8 adımın 2.si),
/// bu yüzden `agents`'a yabancı anahtar yoktur.
model AgentCard {
  agentRecord String          @id @map("agent_record") @db.VarChar(44)
  source      AgentCardSource
  uri         String          @db.Text
  /// Kartın ham baytları; hash doğrulaması ve barındırma bu baytlarla yapılır.
  raw         Bytes
  /// SHA-256(raw), küçük harf hex.
  contentHash String          @map("content_hash") @db.Char(64)
  /// Ayrıştırılmış kart (`AgentCard`).
  content     Json
  /// Karttaki yetenek kimlikleri (`/v1/agents?skill=`).
  skills      String[]        @db.Text
  /// `contentHash` zincirdeki `agentCardHash` ile son kontrolde eşleşti mi.
  verified    Boolean
  verifiedAt  DateTime?       @map("verified_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([skills], type: Gin)
  @@map("agent_cards")
}

enum ScreeningStatus {
  clear
  flagged
}

model Screening {
  /// ScreeningRecord PDA'sı.
  address    String          @id @db.VarChar(44)
  wallet     String          @unique @db.VarChar(44)
  status     ScreeningStatus
  screenedAt BigInt          @map("screened_at")
  expiresAt  BigInt          @map("expires_at")
  sourceHash String          @map("source_hash") @db.Char(64)
  account    Json
  slot       BigInt
  indexedAt  DateTime        @map("indexed_at") @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@map("screenings")
}

// ---------------------------------------------------------------- square_escrow (ayna)

enum JobStatus {
  open
  funded
  accepted
  delivered
  disputed
  resolved
  released
  refunded
  cancelled
}

model Job {
  address      String    @id @db.VarChar(44)
  institution  String    @db.VarChar(44)
  agentRecord  String    @map("agent_record") @db.VarChar(44)
  agentWallet  String    @map("agent_wallet") @db.VarChar(44)
  policy       String?   @db.VarChar(44)
  mint         String    @db.VarChar(44)
  amount       Decimal   @db.Decimal(20, 0)
  specHash     String    @map("spec_hash") @db.Char(64)
  status       JobStatus
  createdAt    BigInt    @map("created_at")
  deadline     BigInt
  /// Teslimden sonra challenge penceresinin sonu; teslim edilmemişse 0 (keeper sorgusu).
  challengeEnd BigInt    @map("challenge_end")
  account      Json
  slot         BigInt
  indexedAt    DateTime  @map("indexed_at") @db.Timestamptz(3)
  /// Hesap kapandıysa kapandığı slot.
  closedSlot   BigInt?   @map("closed_slot")

  @@unique([institution, specHash])
  @@index([status, challengeEnd])
  @@index([institution, status])
  @@index([agentRecord, status])
  @@index([agentWallet])
  @@index([policy])
  @@map("jobs")
}

enum DisputeResolution {
  pending
  favorAgent
  favorInstitution
  split
}

/// `Job.dispute` izdüşümü: job başına en fazla bir dispute (program kuralı). Hesap verisi
/// `jobs.account` içindedir; bu tablo `/v1/disputes` filtresi ve sıralaması, arbitrator kuyruğu ve lapse
/// crank'i (BE-22) içindir.
model Dispute {
  job                  String            @id @db.VarChar(44)
  institution          String            @db.VarChar(44)
  agentRecord          String            @map("agent_record") @db.VarChar(44)
  jobStatus            JobStatus         @map("job_status")
  challenger           String            @db.VarChar(44)
  bond                 Decimal           @db.Decimal(20, 0)
  reasonHash           String            @map("reason_hash") @db.Char(64)
  raisedAt             BigInt            @map("raised_at")
  deadline             BigInt
  /// Eşiğe ulaşıldığı zaman; karar yoksa 0.
  decidedAt            BigInt            @map("decided_at")
  /// `execute_resolution` ya da `lapse_dispute`'un kapattığı zaman; açıksa 0.
  closedAt             BigInt            @map("closed_at")
  resolution           DisputeResolution
  lapsed               Boolean
  /// Bit i: sayımın dayandığı setteki `arbitrators[i]` karara oy verdi.
  approvalMask         Int               @map("approval_mask")
  approvalCount        Int               @map("approval_count")
  /// Sayımın dayandığı arbitrator seti (u32). Config'teki sürüm daha yeniyse sonraki oy sayımı sıfırlar
  /// (ADR 0016).
  arbitratorSetVersion BigInt            @map("arbitrator_set_version")
  slot                 BigInt
  indexedAt            DateTime          @map("indexed_at") @db.Timestamptz(3)

  @@index([jobStatus, raisedAt])
  /// Lapse crank'i: son tarihi geçmiş açık dispute'lar.
  @@index([jobStatus, deadline])
  @@index([institution])
  @@index([agentRecord])
  @@map("disputes")
}

enum ClaimStatus {
  listed
  bought
  settled
  defaulted
}

model Claim {
  /// ClaimListing PDA'sı (`["claim", job]`); iptal edilip yeniden listelenebilir.
  address    String      @id @db.VarChar(44)
  job        String      @unique @db.VarChar(44)
  seller     String      @db.VarChar(44)
  /// Satılmadıysa null.
  buyer      String?     @db.VarChar(44)
  status     ClaimStatus
  price      Decimal     @db.Decimal(20, 0)
  faceValue  Decimal     @map("face_value") @db.Decimal(20, 0)
  account    Json
  slot       BigInt
  indexedAt  DateTime    @map("indexed_at") @db.Timestamptz(3)
  closedSlot BigInt?     @map("closed_slot")

  @@index([status])
  @@index([seller])
  @@index([buyer])
  @@map("claims")
}

model AgentReputation {
  address       String   @id @db.VarChar(44)
  agentRecord   String   @unique @map("agent_record") @db.VarChar(44)
  jobsCompleted Decimal  @map("jobs_completed") @db.Decimal(20, 0)
  totalEarned   Decimal  @map("total_earned") @db.Decimal(20, 0)
  account       Json
  slot          BigInt
  indexedAt     DateTime @map("indexed_at") @db.Timestamptz(3)

  @@index([jobsCompleted])
  @@map("agent_reputations")
}

enum ValidationOutcome {
  verified
  refused
  noGate
  noPayout
}

model ValidationRecord {
  address     String            @id @db.VarChar(44)
  job         String            @unique @db.VarChar(44)
  agentRecord String            @map("agent_record") @db.VarChar(44)
  outcome     ValidationOutcome
  account     Json
  slot        BigInt
  indexedAt   DateTime          @map("indexed_at") @db.Timestamptz(3)

  @@index([agentRecord])
  @@map("validation_records")
}

// ---------------------------------------------------------------- square_verifier (ayna)

enum ReleaseVerdict {
  compliant
  refused
}

model ReleaseProof {
  address        String         @id @db.VarChar(44)
  job            String         @unique @db.VarChar(44)
  institution    String         @db.VarChar(44)
  policy         String         @db.VarChar(44)
  payee          String         @db.VarChar(44)
  verdict        ReleaseVerdict
  refusalCode    Int            @map("refusal_code")
  consumed       Boolean
  netAmount      Decimal        @map("net_amount") @db.Decimal(20, 0)
  proofTimestamp BigInt         @map("proof_timestamp")
  account        Json
  slot           BigInt
  indexedAt      DateTime       @map("indexed_at") @db.Timestamptz(3)

  @@index([institution])
  @@index([consumed])
  @@map("release_proofs")
}

// ---------------------------------------------------------------- zincir dışı veri

/// Teslimat içeriğinin kaydı (`uploadDelivery`). İçerik nesne deposundadır; burada yalnızca
/// konumu ve `submit_work`'e giden hash / URI tutulur.
model Delivery {
  id          String   @id @default(uuid()) @db.Uuid
  job         String   @db.VarChar(44)
  workHash    String   @map("work_hash") @db.Char(64)
  deliveryUri String   @map("delivery_uri") @db.VarChar(128)
  contentType String   @map("content_type") @db.VarChar(120)
  byteSize    BigInt   @map("byte_size")
  /// Nesne deposundaki anahtar.
  storageKey  String   @map("storage_key") @db.Text
  uploadedBy  String   @map("uploaded_by") @db.VarChar(44)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([job, workHash])
  @@map("deliveries")
}

enum EvidenceRole {
  institution
  agent
  arbitrator
}

/// Dispute kanıtı (BE-22). İçerik özel nesne deposundadır (herkese açık değil); burada konumu ve SHA-256'sı
/// tutulur. Kurumun yüklediği içeriğin hash'i `raise_dispute`'un `reason_hash`'idir. Okuyan: kurum, agent
/// cüzdanı / sahibi ve aktif arbitrator'lar.
model DisputeEvidence {
  id          String       @id @default(uuid()) @db.Uuid
  job         String       @db.VarChar(44)
  contentHash String       @map("content_hash") @db.Char(64)
  contentType String       @map("content_type") @db.VarChar(120)
  byteSize    BigInt       @map("byte_size")
  /// Nesne deposundaki anahtar.
  storageKey  String       @map("storage_key") @db.Text
  role        EvidenceRole
  uploadedBy  String       @map("uploaded_by") @db.VarChar(44)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([job, contentHash])
  @@index([job, createdAt])
  @@map("dispute_evidence")
}

/// Arbitrator bildirim olayları; değerler Standard Webhooks `type` adlarıdır (API `ArbitrationEventType`).
enum ArbitrationEvent {
  disputeRaised    @map("dispute.raised")
  disputeEscalated @map("dispute.escalated")
  disputeVote      @map("dispute.vote")
  disputeDecided   @map("dispute.decided")
  disputeDeadline  @map("dispute.deadline")
}

/// Arbitrator'ın kaydettiği webhook ucu (BE-22). Sır, gönderimi imzalamak için gerekir; secret box'la
/// (`@squaresdk/solana-hardening`) şifreli saklanır, AAD kaydın kimliğidir.
model ArbitrationWebhook {
  id         String                 @id @default(uuid()) @db.Uuid
  wallet     String                 @db.VarChar(44)
  url        String                 @db.VarChar(512)
  events     ArbitrationEvent[]
  secret     String                 @db.Text
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries NotificationDelivery[]

  @@unique([wallet, url])
  @@map("arbitration_webhooks")
}

enum DeliveryState {
  pending
  delivered
  failed
}

/// Bildirim outbox'ı: bir olay bir uca bir kez kuyruğa girer (`event_key`), gönderici yeniden denemeyle
/// teslim eder. Teslimat kimliği (`webhook-id`) satırın kimliğidir; denemeler arasında değişmez.
model NotificationDelivery {
  id            String             @id @default(uuid()) @db.Uuid
  webhookId     String             @map("webhook_id") @db.Uuid
  /// Olayın tekil anahtarı: `event:<chain_events.id>` ya da `deadline:<job>:<raised_at>`.
  eventKey      String             @map("event_key") @db.Text
  type          ArbitrationEvent
  job           String             @db.VarChar(44)
  /// Gönderilecek gövde (`ArbitrationNotification`).
  payload       Json
  state         DeliveryState      @default(pending)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @map("next_attempt_at") @db.Timestamptz(3)
  /// Bir gönderici örneğinin kiralaması; süresi dolmadan başka örnek satırı almaz.
  lockedUntil   DateTime?          @map("locked_until") @db.Timestamptz(3)
  lastStatus    Int?               @map("last_status")
  lastError     String?            @map("last_error") @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt   DateTime?          @map("delivered_at") @db.Timestamptz(3)
  webhook       ArbitrationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventKey])
  @@index([state, nextAttemptAt])
  @@map("notification_outbox")
}

/// Bildirim kuyruğuna alınmış son `chain_events.id`.
model NotificationCursor {
  name        String   @id @db.Text
  lastEventId BigInt   @map("last_event_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_cursors")
}

enum KeeperActionKind {
  finalizePayment
  executeResolution
  lapseDispute
}

enum KeeperOutcome {
  submitted
  confirmed
  skipped
  failed
}

enum KeeperReason {
  challengeOpen
  proofRequired
  staleProof
  screeningPending
  unprofitable
  rpcError
  programError
}

/// Keeper günlüğü (`KeeperAction`, API `/v1/keeper/actions`, BE-15).
model KeeperAction {
  id            String           @id @default(uuid()) @db.Uuid
  job           String           @db.VarChar(44)
  action        KeeperActionKind
  outcome       KeeperOutcome
  /// Bekletme ya da başarısızlık sebebi; başarılı gönderimde null.
  reason        KeeperReason?
  signature     String?          @db.VarChar(88)
  keeperFee     Decimal?         @map("keeper_fee") @db.Decimal(20, 0)
  at            DateTime         @default(now()) @db.Timestamptz(3)
  nextAttemptAt DateTime?        @map("next_attempt_at") @db.Timestamptz(3)

  @@index([job, at])
  @@index([outcome, at])
  @@map("keeper_actions")
}

// ---------------------------------------------------------------- screener (BE-16)

enum ScreeningTrigger {
  /// API'den gelen tarama isteği.
  request
  /// TTL yenileme döngüsü.
  renewal
}

enum ScreeningOutcome {
  /// Karar verildi ve `record_screening` tx'i onaylandı.
  recorded
  /// Bir kaynak yanıt vermedi; karar verilmedi, tx gönderilmedi.
  sourceError
  /// Karar verildi ama tx reddedildi, düştü ya da süresi doldu.
  txFailed
}

/// Screener'ın denetim kaydı: her tarama kararı (kaynak sonuçları, kanıt, tx imzası, zaman). Zincir dışı
/// tablodur; zincirdeki `ScreeningRecord`'un aynası `screenings`'tir (indexer). `evidence` kanonik JSON'unun
/// (RFC 8785) SHA-256'sı zincire yazılan `source_hash`'tir: kayıt kanıttan yeniden hesaplanarak doğrulanır.
model ScreeningDecision {
  id         String           @id @default(uuid()) @db.Uuid
  wallet     String           @db.VarChar(44)
  trigger    ScreeningTrigger
  outcome    ScreeningOutcome
  /// Kaynakların birleşik kararı; kaynak hatasında null.
  status     ScreeningStatus?
  /// Kaynak başına sonuç ya da hata (`SourceOutcome[]` JSON'u).
  sources    Json
  evidence   Json?
  sourceHash String?          @map("source_hash") @db.Char(64)
  signature  String?          @db.VarChar(88)
  /// Tx'in onaylandığı slot ve zincirden okunan kaydın zamanları (Unix saniyesi).
  slot       BigInt?
  screenedAt BigInt?          @map("screened_at")
  expiresAt  BigInt?          @map("expires_at")
  /// Başarısızlığın sebebi; başarılı kararda null.
  error      String?
  /// İsteği yapan API anahtarının SHA-256 önekidir; yenilemede null.
  caller     String?          @db.VarChar(16)
  at         DateTime         @default(now()) @db.Timestamptz(3)

  @@index([wallet, at])
  @@index([outcome, wallet])
  @@map("screening_decisions")
}

// ---------------------------------------------------------------- kullanıcılar ve yetki

/// Cüzdanla oturum açan kullanıcı. Kimlik cüzdan adresidir.
model User {
  wallet     String          @id @db.VarChar(44)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime?       @map("last_seen_at") @db.Timestamptz(3)
  challenges    AuthChallenge[]
  sessions      Session[]
  apiKeys       ApiKey[]
  x402Endpoints X402Endpoint[]

  @@map("users")
}

/// Cüzdanın imzalayacağı tek kullanımlık mesaj (`createAuthChallenge`).
model AuthChallenge {
  nonce      String    @id @db.Text
  wallet     String    @db.VarChar(44)
  message    String    @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet])
  @@index([expiresAt])
  @@map("auth_challenges")
}

/// Oturum. Belirtecin kendisi saklanmaz, yalnızca SHA-256'sı.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  wallet    String    @db.VarChar(44)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet])
  @@index([expiresAt])
  @@map("sessions")
}

enum ApiKeyScope {
  read
  txPrepare       @map("tx:prepare")
  deliveriesWrite @map("deliveries:write")
  agentsWrite     @map("agents:write")
  prove
  disputesWrite   @map("disputes:write")
  x402Serve       @map("x402:serve")
}

/// API anahtarı (`ApiKey`). Gizli değer saklanmaz, yalnızca SHA-256'sı; `prefix` listelemede gösterilir.
model ApiKey {
  id         String        @id @default(uuid()) @db.Uuid
  wallet     String        @db.VarChar(44)
  label      String        @db.VarChar(80)
  prefix     String        @db.VarChar(16)
  secretHash String        @unique @map("secret_hash") @db.Char(64)
  scopes     ApiKeyScope[]
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(3)
  user       User          @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet])
  @@map("api_keys")
}

// ---------------------------------------------------------------- x402 ücretli uç noktalar (FE-22)

/// x402 v2'nin Solana ağları; değerler CAIP-2 kimlikleridir (`@squaresdk/solana-types` X402NetworkSchema).
enum X402Network {
  mainnet @map("solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp")
  devnet  @map("solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1")
  testnet @map("solana:4uhcVJyU9pJkvQyS88uRDiswHXSCkY3z")
}

/// Geliştiricinin ücretli uç nokta tanımı (`X402Endpoint`, ADR 0023). Ödemeyi geliştiricinin sunucusu ister
/// (`@squaresdk/solana-x402` `paidRouteFromDefinition`); yol cüzdan başına tekildir.
model X402Endpoint {
  id          String        @id @default(uuid()) @db.Uuid
  wallet      String        @db.VarChar(44)
  name        String        @db.VarChar(80)
  /// Geliştiricinin sunucusundaki route yolu.
  path        String        @db.VarChar(200)
  description String?       @db.VarChar(500)
  /// Çağrı başına fiyat, mint'in taban biriminde (> 0).
  amount      Decimal       @db.Decimal(20, 0)
  mint        String        @db.VarChar(44)
  network     X402Network
  payTo       String        @map("pay_to") @db.VarChar(44)
  enabled     Boolean
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  payments    X402Payment[]

  @@unique([wallet, path])
  @@map("x402_endpoints")
}

/// Geliştiricinin sunucusunun bildirdiği uzlaştırılmış ödeme (`X402Payment`). `fingerprint` ödeme yükünün
/// tekrar koruması kimliğidir (`ReplayStore`'daki `(x402:<ağ>, kimlik)`; Postgres deposunda `replay_guards`),
/// `transaction` uzlaştırma makbuzunun (`PAYMENT-RESPONSE`) işlem imzası. İkisi de ağ başına tekildir: aynı ödeme
/// iki kez sayılmaz. Tanım silinince ödemeleri de silinir.
model X402Payment {
  id          String       @id @default(uuid()) @db.Uuid
  endpointId  String       @map("endpoint_id") @db.Uuid
  /// `svm:<64 hex>` ya da `json:<64 hex>`.
  fingerprint String       @db.VarChar(69)
  transaction String       @db.VarChar(88)
  network     X402Network
  asset       String       @db.VarChar(44)
  amount      Decimal      @db.Decimal(20, 0)
  payer       String       @db.VarChar(44)
  payTo       String       @map("pay_to") @db.VarChar(44)
  /// Geliştiricinin sunucusunun bildirdiği uzlaştırma anı.
  settledAt   DateTime     @map("settled_at") @db.Timestamptz(3)
  reportedAt  DateTime     @default(now()) @map("reported_at") @db.Timestamptz(3)
  endpoint    X402Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([network, fingerprint])
  @@unique([network, transaction])
  @@index([endpointId, settledAt])
  @@map("x402_payments")
}

// ---------------------------------------------------------------- ödeme rayları

/// İmzası doğrulanmış Stripe webhook'undan gelen MPP (fiat) ödemesi (BE-25). Kaynak:
/// Aperture compliance-api `verified_payment_intents` (apps/compliance-api, migration 005).
model MppPayment {
  stripePaymentIntentId String   @id @map("stripe_payment_intent_id") @db.Text
  /// Webhook event kimliği; Stripe'ın yeniden gönderimi ikinci satır üretemez.
  stripeEventId         String   @unique @map("stripe_event_id") @db.Text
  amountMinor           BigInt   @map("amount_minor")
  /// ISO 4217, küçük harf.
  currency              String   @db.Char(3)
  /// Stripe PaymentIntent durumu; yalnızca `succeeded` satırlar kullanılabilir.
  status                String   @db.Text
  stripeCustomer        String?  @map("stripe_customer") @db.Text
  /// Kanonik makbuzun Poseidon commitment'ı (devrenin `stripe_receipt_hash` girdisi).
  receiptHash           String   @map("receipt_hash") @db.Char(64)
  /// MPP authority'nin `receiptHash` üzerindeki Ed25519 imzası, base58.
  authoritySignature    String   @map("authority_signature") @db.VarChar(88)
  /// Ödemenin bağlandığı kurum ve job (BE-25 kararıyla doldurulur).
  institution           String?  @db.VarChar(44)
  job                   String?  @db.VarChar(44)
  paidAt                DateTime @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status])
  @@index([institution])
  @@index([job])
  @@map("mpp_payments")
}

enum CctpTransferStatus {
  /// Burn kaydedildi, Circle'ın attestation'ı bekleniyor.
  pendingAttestation
  /// Mesaj imzalandı, Solana'da henüz teslim edilmedi.
  attested
  /// `receive_message` tamamlandı: USDC kurumun hesabında, job henüz fonlanmadı.
  received
  /// Job fonlandı.
  funded
  /// Devam edilemez (mesaj bu job'un kurumuna değil, job iptal edildi …); sebep `error`'da.
  failed
}

/// CCTP ile bir job'u fonlayan USDC transferi (BE-26, docs/design/cctp-funding.md). Kurum kaynak zincirdeki burn
/// tx'ini kaydeder; relayer (keeper) Circle'ın attestation'ını izler, gerekirse mesajı Solana'da teslim eder ve
/// job'un fonlanmasını izler. Mesaj ve attestation herkese açıktır (Circle'ın servisi). Burn tx'inde tek mesaj
/// beklenir.
model CctpTransfer {
  id               String             @id @default(uuid()) @db.Uuid
  sourceDomain     Int                @map("source_domain")
  /// Kaynak zincirdeki burn tx'i, 0x'li küçük harf hex.
  sourceTxHash     String             @map("source_tx_hash") @db.VarChar(66)
  job              String             @db.VarChar(44)
  /// Job'un `institution`'ı: kaydı yapan ve fonlama tx'ini imzalayan anahtar.
  institution      String             @db.VarChar(44)
  /// Beklenen mint alıcısı: kurumun settlement mint'indeki token hesabı.
  mintRecipient    String             @map("mint_recipient") @db.VarChar(44)
  status           CctpTransferStatus
  /// Circle'ın atadığı nonce (V2'de 32 bayt); attestation'dan önce null.
  nonce            String?            @db.Char(64)
  /// Attestation'lı mesaj, hex.
  message          String?            @db.Text
  /// Circle'ın attestation'ı, hex.
  attestation      String?            @db.Text
  /// Yakılan tutar; mint edilen `amount − fee_executed`.
  amount           Decimal?           @db.Decimal(20, 0)
  feeExecuted      Decimal?           @map("fee_executed") @db.Decimal(20, 0)
  attestedAt       DateTime?          @map("attested_at") @db.Timestamptz(3)
  receiveSignature String?            @map("receive_signature") @db.VarChar(88)
  fundSignature    String?            @map("fund_signature") @db.VarChar(88)
  /// Relayer'ın bu durumdaki ardışık denemesi; durum değişince sıfırlanır.
  attempts         Int                @default(0)
  /// Relayer'ın bir sonraki bakışı; null ise ilk turda.
  nextAttemptAt    DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  /// Son denemenin hatası ya da `failed` sebebi.
  error            String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sourceDomain, sourceTxHash])
  @@unique([sourceDomain, nonce])
  @@index([status, nextAttemptAt])
  @@index([job])
  @@index([institution])
  @@map("cctp_transfers")
}

// ---------------------------------------------------------------- Travel Rule (BE-23, ADR 0017)

/// Job'un Travel Rule kaydı. Kayıt ve salt zarf şifrelemesiyle saklanır (`@squaresdk/solana-hardening`
/// `SecretBox`): kaydı şifreleyen veri anahtarı `key_id`'li ana anahtarla sarılıdır; düz metin sütunu yoktur. Zincirde yalnızca commitment vardır
/// (`TravelRuleCommitted`). Saklama süresi dolunca şifreli alanlar silinir (`purged_at`); commitment ve özet kalır.
model TravelRuleRecord {
  id           String    @id @default(uuid()) @db.Uuid
  job          String    @unique @db.VarChar(44)
  /// `sha256("square/travel-rule/v1" ‖ job ‖ salt ‖ record_digest)`.
  commitment   String    @db.Char(64)
  /// Kaydın RFC 8785 kanonik JSON'unun SHA-256'sı.
  recordDigest String    @map("record_digest") @db.Char(64)
  /// Şifreli `{ record, salt }`: kayda özgü veri anahtarıyla `SecretBox` değeri (`sq1.record.<iv>.<veri>`).
  ciphertext   String?   @db.Text
  /// Veri anahtarını saran ana anahtarın kimliği (`API_TRAVEL_RULE_KEYS`); yeniden sarma bununla seçilir.
  keyId        String?   @map("key_id") @db.VarChar(32)
  /// Ana anahtar halkasıyla sarılmış veri anahtarı (`SecretBox` değeri, `sq1.<key_id>.<iv>.<veri>`).
  wrappedKey   String?   @map("wrapped_key") @db.Text
  storedBy     String    @map("stored_by") @db.VarChar(44)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Son yazma; saklama süresi buradan sayılır.
  storedAt     DateTime  @map("stored_at") @db.Timestamptz(3)
  retainUntil  DateTime  @map("retain_until") @db.Timestamptz(3)
  purgedAt     DateTime? @map("purged_at") @db.Timestamptz(3)

  @@index([retainUntil])
  @@index([keyId])
  @@map("travel_rule_records")
}

/// Kaydı okuma izni (karşı VASP, denetçi).
model TravelRuleGrant {
  job       String    @db.VarChar(44)
  grantee   String    @db.VarChar(44)
  purpose   String    @db.VarChar(200)
  grantedBy String    @map("granted_by") @db.VarChar(44)
  grantedAt DateTime  @map("granted_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@id([job, grantee])
  @@map("travel_rule_grants")
}

enum TravelRuleAccessAction {
  store
  read
  grant
  revoke
  purge
}

/// Erişim kaydı: kişisel veriye dokunan her işlem (yalnızca eklenir).
model TravelRuleAccess {
  id        String                 @id @default(uuid()) @db.Uuid
  job       String                 @db.VarChar(44)
  action    TravelRuleAccessAction
  /// İşlemi yapan cüzdan; saklama süresiyle silmede null.
  actor     String?                @db.VarChar(44)
  grantee   String?                @db.VarChar(44)
  requestId String?                @map("request_id") @db.Uuid
  at        DateTime               @db.Timestamptz(3)

  @@index([job, at])
  @@map("travel_rule_accesses")
}

// ---------------------------------------------------------------- servis korumaları (BE-13)

/// Kalıcı hız sınırı (`@squaresdk/solana-hardening`): anahtar başına sabit pencere sayacı. Pencere değişince
/// sayaç sıfırdan başlar; süresi dolan satırlar `purgeExpired` ile silinir.
model RateLimitWindow {
  /// Sınırın kapsamı ve öznesi, ör. `api:wallet:<adres>`.
  key         String   @id @db.Text
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_windows")
}

enum IdempotencyState {
  inProgress @map("in_progress")
  completed
}

/// İdempotent istek: aynı anahtarla gelen tekrar istek ilk isteğin kaydedilen yanıtını alır; aynı anahtar
/// başka bir istekle kullanılamaz (`request_hash`).
model IdempotencyRecord {
  scope       String           @db.Text
  key         String           @db.Text
  requestHash String           @map("request_hash") @db.Char(64)
  state       IdempotencyState
  /// Tamamlanınca kaydedilen yanıt.
  status      Int?
  body        Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Tek kullanımlık kimlikler (webhook teslimat kimliği, imzalı eylem nonce'u): tekrar oynatma koruması.
/// Kimlik süresi dolana kadar ikinci kez kabul edilmez; süre, imzanın geçerlilik penceresidir.
model ReplayGuard {
  scope     String   @db.Text
  id        String   @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, id])
  @@index([expiresAt])
  @@map("replay_guards")
}

// ---------------------------------------------------------------- A2A görev deposu (BE-17)

/// A2A v1.0 görev durumu; değerler protokolün JSON adlarıdır (`@squaresdk/solana-types` TaskStateSchema).
enum A2aTaskState {
  TASK_STATE_SUBMITTED
  TASK_STATE_WORKING
  TASK_STATE_COMPLETED
  TASK_STATE_FAILED
  TASK_STATE_CANCELED
  TASK_STATE_INPUT_REQUIRED
  TASK_STATE_REJECTED
  TASK_STATE_AUTH_REQUIRED
}

enum A2aRole {
  ROLE_USER
  ROLE_AGENT
}

/// A2A görevi: bir agent'ın bir job için yaptığı iş (docs/design/a2a.md). Zincir dışı tablodur; job ve
/// agent kaydının doğruluk kaynağı zincirdir, burada görevin protokol durumu tutulur. Görevin A2A
/// bağlamı (`contextId`) job adresidir. Bir job için en fazla bir terminal olmayan görev olur: migration'daki
/// kısmi tekil indeks `a2a_tasks_active_job_key`.
model A2aTask {
  id              String       @id @default(uuid()) @db.Uuid
  /// Görevi sunan agent'ın AgentRecord PDA'sı.
  agentRecord     String       @map("agent_record") @db.VarChar(44)
  /// Kimliği doğrulanmış çağıran; görevler yalnızca onu açan çağırana görünür.
  caller          String       @db.Text
  job             String       @db.VarChar(44)
  specHash        String       @map("spec_hash") @db.Char(64)
  state           A2aTaskState
  /// Durumla gelen agent mesajı (`TaskStatus.message`); mesaj yoksa `{}`.
  statusMessage   Json         @default("{}") @map("status_message")
  statusAt        DateTime     @map("status_at") @db.Timestamptz(3)
  /// `Artifact[]` JSON'u.
  artifacts       Json         @default("[]")
  /// Görevi açan mesajın kimliği ve içeriğinin SHA-256'sı; aynı mesaj ikinci görev açmaz.
  createMessageId String       @map("create_message_id") @db.Text
  createHash      String       @map("create_hash") @db.Char(64)
  /// Sunucunun zincirde son gördüğü job durumu ve slotu; durum değişince yazılır (ayna veri değildir).
  jobStatus       JobStatus    @map("job_status")
  jobSlot         BigInt?      @map("job_slot")
  /// İyimser eşzamanlılık sayacı; her güncelleme bir artırır.
  version         Int          @default(0)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages        A2aMessage[]

  @@unique([agentRecord, caller, createMessageId])
  @@index([agentRecord, caller, statusAt(sort: Desc)])
  @@index([agentRecord, job])
  @@map("a2a_tasks")
}

/// Görevin mesaj geçmişi (`Task.history`).
model A2aMessage {
  /// Ekleme sırası; geçmiş bu sırayla döner.
  id        BigInt   @id @default(autoincrement())
  taskId    String   @map("task_id") @db.Uuid
  messageId String   @map("message_id") @db.Text
  role      A2aRole
  /// `Message` JSON'u.
  content   Json
  /// İstemcinin devam mesajı agent'a iletilip işlenene kadar true; yeniden başlatmada yeniden iletilir.
  pending   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  task      A2aTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, messageId])
  @@index([taskId, id])
  @@map("a2a_messages")
}

// ---------------------------------------------------------------- fee payer (BE-27)

enum SponsoredTxStatus {
  /// İmzalandı ve kullanıcıya döndü (kullanıcı gönderir).
  signed
  /// Servis RPC'ye gönderdi.
  submitted
  /// Gönderim RPC'de reddedildi; bütçeye sayılmaz.
  failed
}

/// Sponsorlanan tx'in maliyet günlüğü (apps/fee-payer, ADR 0019). Kullanıcının ve servisin günlük bütçesi bu
/// tablodan denetlenir: UTC günü içinde, başarısız gönderimler hariç `fee_lamports + rent_lamports` toplamı.
/// Maliyet imzadan önceki simülasyondandır: ücret `getFeeForMessage`, rent sponsor bakiyesindeki farktan ücret düşülerek.
model SponsoredTx {
  id               String            @id @default(uuid()) @db.Uuid
  /// Tx'in ilk imzası (sponsorun imzası); tx kimliğidir.
  signature        String            @unique @db.VarChar(88)
  /// İstek sahibinin cüzdanı (oturum ya da API anahtarının sahibi); bütçe bu anahtarla sayılır.
  wallet           String            @db.VarChar(44)
  /// API anahtarıyla gelen istekte anahtarın kimliği.
  apiKeyId         String?           @map("api_key_id") @db.Uuid
  status           SponsoredTxStatus
  feeLamports      Decimal           @map("fee_lamports") @db.Decimal(20, 0)
  rentLamports     Decimal           @map("rent_lamports") @db.Decimal(20, 0)
  /// Simülasyonda tüketilen compute unit.
  computeUnits     Int?              @map("compute_units")
  computeUnitLimit Int               @map("compute_unit_limit")
  /// Mikro-lamport / CU.
  computeUnitPrice Decimal           @map("compute_unit_price") @db.Decimal(20, 0)
  /// Denetlenen talimatlar (`<program>:<talimat>`; vault tx'inin içindekiler `vault>` önekiyle).
  instructions     String[]
  /// Başarısız gönderimin RPC hatası.
  error            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([wallet, createdAt])
  @@index([createdAt])
  @@map("sponsored_txs")
}
