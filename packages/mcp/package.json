{
  "name": "@squaresdk/solana-mcp",
  "version": "0.1.0",
  "description": "Square MCP sunucusu (okuma ve imzasız tx hazırlayan yazma tool'ları, stdio ve Streamable HTTP) ve agent'lar için havuzlu MCP istemcisi; BE-28",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "bin": {
    "square-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "bs58": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "ai-agents",
    "settlement",
    "escrow",
    "square"
  ]
}
