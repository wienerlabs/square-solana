{
  "name": "@squaresdk/solana-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "İki yönlü MCP: Square MCP sunucusu (okuma ve imza akışlı yazma araçları, zincirden) ve agent'lar için havuzlu MCP istemcisi; BE-28",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "bin": {
    "square-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-identity": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "bs58": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
