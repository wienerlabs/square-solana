{
  "name": "@squaresdk/solana-a2a",
  "version": "0.1.0",
  "description": "A2A v1.0 görev protokolü (JSON-RPC 2.0 + SSE): sunucu, istemci, kalıcı görev deposu ve job durumu eşlemesi; BE-17",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma-store.d.ts",
      "import": "./dist/prisma-store.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@squaresdk/solana-db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@squaresdk/solana-db": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@coral-xyz/anchor": "0.31.1",
    "@squaresdk/solana-config": "workspace:*",
    "@squaresdk/solana-db": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
