    "gen": "node scripts/gen-idl-schemas.mjs",
    "gen:check": "node scripts/gen-idl-schemas.mjs --check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
