{
  "name": "@squaresdk/solana-types",
  "version": "0.1.0",
  "description": "Square ortak tipleri: API zarfı, görünümler, agent card, A2A görevi, event payload'ları (zod) — BE-35 sözleşmesi",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
