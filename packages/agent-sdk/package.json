{
  "name": "@squaresdk/solana-agent-sdk",
  "version": "0.2.1",
  "description": "Square agent yazma kiti: agent card ve well-known yolu, A2A uç noktası, job kabulü ve teslimi (teslimat yükleme + submit_work), isteğe bağlı alacak listeleme, register_agent yardımcısı; BE-19",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:localnet": "SQUARE_LOCALNET=1 vitest run test/localnet.e2e.test.ts",
    "example:text-stats": "tsc -p tsconfig.examples.json && node examples/dist/examples/text-stats-agent.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-a2a": "workspace:*",
    "@squaresdk/solana-identity": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@anchor-lang/core": "1.2.0",
    "@anthropic-ai/sdk": "^0.131.0",
    "@noble/curves": "2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@squaresdk/solana-config": "workspace:*",
    "@squaresdk/solana-db": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "square",
    "solana",
    "agent",
    "a2a",
    "did:aip",
    "escrow",
    "sdk"
  ],
  "engines": {
    "node": ">=24"
  }
}
