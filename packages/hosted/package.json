{
  "name": "@squaresdk/solana-hosted",
  "version": "0.1.0",
  "description": "Konfigürasyondan çalışan kurum agent'ı: capability başına yalnızca izinli MCP tool'larını gören Claude çalıştırması, kurum politikası altında delegasyon, ispat bağlama ve dispute crank'i; BE-29",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "square-hosted": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:localnet": "SQUARE_LOCALNET=1 vitest run test/localnet.e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-a2a": "workspace:*",
    "@squaresdk/solana-agent-sdk": "workspace:*",
    "@squaresdk/solana-mcp": "workspace:*",
    "@squaresdk/solana-policy": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "bs58": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@squaresdk/solana-db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@squaresdk/solana-db": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@squaresdk/solana-config": "workspace:*",
    "@squaresdk/solana-db": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "square",
    "solana",
    "agent",
    "hosted-agent",
    "mcp",
    "claude",
    "a2a",
    "escrow"
  ],
  "engines": {
    "node": ">=24"
  }
}
