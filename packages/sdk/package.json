{
  "name": "@squaresdk/solana-sdk",
  "version": "0.1.0",
  "description": "Square Solana SDK sözleşmesi: 4 programın IDL'leri, IDL'den türetilen tipler, client / PDA / tx builder / REST client arayüzleri (uygulama BE-08, BE-18)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./squads": {
      "types": "./dist/squads.d.ts",
      "import": "./dist/squads.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "gen": "node scripts/gen-idl-types.mjs",
    "gen:check": "node scripts/gen-idl-types.mjs --check"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "2.1.4",
    "@squaresdk/solana-types": "workspace:*",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "@types/bn.js": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
