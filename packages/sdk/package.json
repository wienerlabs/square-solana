{
  "name": "@squaresdk/solana-sdk",
  "version": "0.1.0",
  "description": "Square Solana SDK sözleşmesi: 4 programın IDL'leri, IDL'den türetilen tipler, client / PDA / tx builder / REST client arayüzleri (uygulama BE-08, BE-18)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen": "node scripts/gen-idl-types.mjs",
    "gen:check": "node scripts/gen-idl-types.mjs --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-types": "workspace:*"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
