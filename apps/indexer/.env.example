# indexer ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Program kimlikleri ortamdan değil,
# veritabanının `programs` tablosundan okunur (db paketinin seed'i, SQUARE_PROGRAM_ID_*).

# --- Veritabanı (zorunlu) ---
DATABASE_URL=

# --- Solana RPC (zorunlu) ---
# Virgülle ayrılmış http(s) uçları; ilki tercih edilir, hata veren uç INDEXER_RPC_COOLDOWN_MS boyunca atlanır
INDEXER_RPC_URLS=
INDEXER_RPC_TIMEOUT_MS=
INDEXER_RPC_COOLDOWN_MS=

# --- Sunucu (zorunlu) ---
# /health, /ready ve webhook
INDEXER_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (INDEXER_PORT'tan farklı)
INDEXER_METRICS_PORT=

# --- Tarama ve uzlaştırma (zorunlu) ---
INDEXER_POLL_INTERVAL_MS=
# getSignaturesForAddress sayfa boyu (1–1000)
INDEXER_SIGNATURE_PAGE_SIZE=
INDEXER_RECONCILE_INTERVAL_SECONDS=

# --- Helius webhook (isteğe bağlı) ---
# Helius'a verilen Authorization değerinin SHA-256'sı (64 hex). Boşsa webhook ucu kapalı.
INDEXER_WEBHOOK_AUTH_SHA256=
# Yukarıdaki verilince zorunlu:
INDEXER_WEBHOOK_MAX_BODY_BYTES=
INDEXER_WEBHOOK_MAX_PENDING=
INDEXER_WEBHOOK_PENDING_TTL_SECONDS=

# --- Alarmlar (zorunlu) ---
INDEXER_ALERT_STALL_SECONDS=
INDEXER_ALERT_DRIFT=
INDEXER_ALERT_ERRORS=
INDEXER_ALERT_ERROR_WINDOW_SECONDS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
