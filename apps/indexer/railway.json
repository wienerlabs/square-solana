{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/indexer/Dockerfile",
    "watchPatterns": [
      "/apps/indexer/**",
      "/db/**",
      "/packages/config/**",
      "/packages/hardening/**",
      "/packages/identity/**",
      "/packages/observability/**",
      "/packages/sdk/**",
      "/packages/types/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
