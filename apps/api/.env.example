# API ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Program kimlikleri veritabanının `programs`
# tablosundan (db seed'i), did:aip ağ referansı RPC'nin genesis hash'inden okunur.

# --- Veritabanı (zorunlu) ---
DATABASE_URL=

# --- Sunucu (zorunlu) ---
API_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (API_PORT'tan farklı)
API_METRICS_PORT=
# API'nin dış adresi (https): agent card URI'leri ve OpenAPI `servers`; en çok 123 karakter
API_PUBLIC_BASE_URL=
# Virgülle ayrılmış izinli origin'ler (web uygulaması)
CORS_ORIGINS=
# İstemci IP'si için güvenilen vekil sayısı (Railway önünde 1)
API_TRUST_PROXY_HOPS=
# JSON gövde sınırı (bayt)
API_JSON_MAX_BYTES=

# --- Solana RPC (zorunlu) ---
# Virgülle ayrılmış http(s) uçları; hata veren uç API_RPC_COOLDOWN_MS boyunca atlanır
API_RPC_URLS=
API_RPC_TIMEOUT_MS=
API_RPC_COOLDOWN_MS=

# --- Oturum (zorunlu) ---
# İmzalanan mesajdaki alan adı (ör. app.example.com)
API_AUTH_DOMAIN=
API_AUTH_CHALLENGE_TTL_SECONDS=
API_SESSION_TTL_SECONDS=

# --- Hız sınırı (zorunlu) ---
API_RATE_LIMIT_WINDOW_SECONDS=
API_RATE_LIMIT_READ=
API_RATE_LIMIT_WRITE=

# --- Teslimat deposu, S3 uyumlu (zorunlu) ---
API_DELIVERY_S3_ENDPOINT=
API_DELIVERY_S3_REGION=
# Teslimatların kovası; nesneleri herkese açık okunur
API_DELIVERY_S3_BUCKET=
# Depoya yazma kimliği (yalnızca bu kovaya PutObject ve HeadBucket yetkisi yeterli)
API_DELIVERY_S3_ACCESS_KEY_ID=
# Kimliğin gizli anahtarı
API_DELIVERY_S3_SECRET_ACCESS_KEY=
# true | false (yol biçimli adresleme)
API_DELIVERY_S3_FORCE_PATH_STYLE=
# Nesnelerin herkese açık taban adresi; deliveryUri = <taban>/<workHash>, en çok 63 karakter
API_DELIVERY_PUBLIC_BASE_URL=
API_DELIVERY_MAX_BYTES=

# --- Dispute kanıtı (zorunlu, BE-22) ---
# Kanıtların kovası: teslimat deposuyla aynı uç nokta ve kimlik; herkese açık OKUNMAZ (kanıt API'den indirilir)
API_EVIDENCE_S3_BUCKET=
API_EVIDENCE_MAX_BYTES=
# Escrow config'inden okunan arbitrator setinin önbellek süresi
API_ARBITRATOR_CACHE_SECONDS=

# --- Arbitrator bildirimleri (zorunlu, BE-22) ---
# Webhook sırlarının şifreleme anahtar halkası: kimlik:base64,kimlik:base64 (her anahtar 32 bayt;
# openssl rand -base64 32) ve yeni değerleri şifreleyen anahtarın kimliği
API_SECRET_BOX_KEYS=
API_SECRET_BOX_ACTIVE_KEY=
# Outbox turu aralığı ve tur başına en fazla teslimat
API_NOTIFY_INTERVAL_MS=
API_NOTIFY_BATCH_SIZE=
# Bir teslimatın süre sınırı; aşan ya da 2xx dışı dönen teslimat yeniden denenir
API_NOTIFY_TIMEOUT_MS=
API_NOTIFY_MAX_ATTEMPTS=
# Yeniden deneme: ilk bekleme, her denemede ikiye katlanır, üst sınır
API_NOTIFY_BACKOFF_BASE_SECONDS=
API_NOTIFY_BACKOFF_MAX_SECONDS=
# Son tarihe bu kadar saniye kala oy vermemiş arbitrator'lara dispute.deadline gönderilir
API_NOTIFY_DEADLINE_WARNING_SECONDS=
# true yalnızca geliştirmede: webhook ucu http ve özel ağ adresi olabilir
API_NOTIFY_ALLOW_INSECURE=

# --- Tx hazırlama ---
# İsteğe bağlı: Square address lookup table'ı (BC-28); verilirse her tx'e eklenir
API_LOOKUP_TABLE=
# Zorunlu: computeUnitPrice verilmeyen tx'lerin priority fee'si (mikro-lamport / CU)
API_COMPUTE_UNIT_PRICE=

# --- Prover vekili (zorunlu) ---
API_PROVER_URL=
# API'nin prover'a gönderdiği servis anahtarı (prover'ın PROVER_API_KEY_SHA256 listesinde)
API_PROVER_API_KEY=
API_PROVER_TIMEOUT_MS=

# --- Alarmlar (zorunlu) ---
API_ALERT_ERRORS=
API_ALERT_ERROR_WINDOW_SECONDS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
