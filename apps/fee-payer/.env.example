# Fee payer ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Program kimlikleri veritabanının `programs`
# tablosundan (db seed'i) okunur. Politika ve limitlerin gerekçesi ADR 0019'dedir.

# --- Veritabanı (zorunlu) ---
DATABASE_URL=

# --- Sunucu (zorunlu) ---
FEE_PAYER_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (FEE_PAYER_PORT'tan farklı)
FEE_PAYER_METRICS_PORT=
# Virgülle ayrılmış izinli origin'ler (web uygulaması)
CORS_ORIGINS=
# İstemci IP'si için güvenilen vekil sayısı (Railway önünde 1)
FEE_PAYER_TRUST_PROXY_HOPS=
# JSON gövde sınırı (bayt); base64 tx en çok ~1650 bayt
FEE_PAYER_JSON_MAX_BYTES=

# --- Solana RPC (zorunlu) ---
# Virgülle ayrılmış http(s) uçları; hata veren uç FEE_PAYER_RPC_COOLDOWN_MS boyunca atlanır
FEE_PAYER_RPC_URLS=
FEE_PAYER_RPC_TIMEOUT_MS=
FEE_PAYER_RPC_COOLDOWN_MS=

# --- Sponsor anahtarı (zorunlu, gizli) ---
# 64 baytlık Ed25519 gizli anahtarı, base58. Platformun gizli değişkeni olarak verilir; repoya, imaja ve
# log'a girmez. Ayrı, yalnızca ücret için tutulan bir sıcak cüzdandır (ADR 0019 §Anahtar).
FEE_PAYER_SECRET_KEY=

# --- Politika ---
# İsteğe bağlı: izinli talimatlar `<program>:<talimat>` (virgülle); boşsa ADR 0019'nin varsayılan listesi
FEE_PAYER_ALLOWED_INSTRUCTIONS=
# Zorunlu: priority fee tavanı (mikro-lamport / CU)
FEE_PAYER_MAX_COMPUTE_UNIT_PRICE=
# Zorunlu: tx başına compute unit sınırı tavanı (en çok 1400000)
FEE_PAYER_MAX_COMPUTE_UNIT_LIMIT=

# --- Bütçe (zorunlu, lamport) ---
# Tek tx'in en yüksek maliyeti (ücret + rent)
FEE_PAYER_MAX_LAMPORTS_PER_TX=
# Kullanıcı (cüzdan) başına günlük bütçe, UTC günü
FEE_PAYER_USER_DAILY_LAMPORTS=
# Bütün kullanıcıların günlük toplamı
FEE_PAYER_GLOBAL_DAILY_LAMPORTS=

# --- Hız sınırı (zorunlu) ---
FEE_PAYER_RATE_LIMIT_WINDOW_SECONDS=
# Pencere başına istek (kullanıcı başına)
FEE_PAYER_RATE_LIMIT=

# --- Alarmlar (zorunlu) ---
# Sponsor bakiyesi bunun altına düşünce `fee_payer_balance_low` çalar (lamport)
FEE_PAYER_MIN_BALANCE_LAMPORTS=
FEE_PAYER_ALERT_ERRORS=
FEE_PAYER_ALERT_ERROR_WINDOW_SECONDS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
