{
  "name": "@squaresdk/solana-fee-payer",
  "version": "0.1.0",
  "private": true,
  "description": "Fee payer (sponsorlu işlem) servisi: kullanıcının v0 tx'ini çözüp politikaya göre denetler (izinli program ve talimatlar, sponsor anahtarının rolü, compute budget tavanı, ALT ve Squads vault mesajları), simüle eder, kullanıcı başına hız sınırı ve günlük lamport bütçesiyle imzalar ya da gönderir; maliyet metrikleri ve günlüğü (BE-27)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-db": "workspace:*",
    "@squaresdk/solana-hardening": "workspace:*",
    "@squaresdk/solana-observability": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@sqds/multisig": "2.1.4",
    "@squaresdk/solana-config": "workspace:*",
    "@squaresdk/solana-policy": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "bn.js": "^5.2.5",
    "snarkjs": "0.7.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
