# keeper ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Program kimlikleri veritabanının `programs`
# tablosundan okunur (db paketinin seed'i, SQUARE_PROGRAM_ID_*).

# --- Veritabanı (zorunlu) ---
DATABASE_URL=

# --- Solana RPC (zorunlu) ---
# Virgülle ayrılmış http(s) uçları; hata veren uç KEEPER_RPC_COOLDOWN_MS boyunca atlanır
KEEPER_RPC_URLS=
KEEPER_RPC_TIMEOUT_MS=
KEEPER_RPC_COOLDOWN_MS=

# --- Keeper cüzdanı (zorunlu) ---
# 64 baytlık gizli anahtar, base58. Ücreti alır; işlem ücretini ve açılan hesapların rent'ini öder.
KEEPER_SECRET_KEY=

# --- Sunucu (zorunlu) ---
# /health ve /ready
KEEPER_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (KEEPER_PORT'tan farklı)
KEEPER_METRICS_PORT=

# --- Crank (zorunlu) ---
KEEPER_POLL_INTERVAL_MS=
# Gönderilen tx'in onay yoklama aralığı
KEEPER_CONFIRM_POLL_MS=
# Bir turda değerlendirilen en fazla job
KEEPER_BATCH_SIZE=
# Bekletilen job'un ilk yeniden deneme aralığı (her tekrarda ikiye katlanır) ve üst sınırı
KEEPER_BACKOFF_BASE_SECONDS=
KEEPER_BACKOFF_MAX_SECONDS=

# --- Kârlılık ve priority fee (zorunlu) ---
# 1 SOL'ün settlement mint'inin taban birimindeki karşılığı (ör. USDC, 1 SOL = 150 USD: 150000000)
KEEPER_MINT_UNITS_PER_SOL=
# Keeper ücretinin maliyeti aşması gereken pay (baz puan); 0 başa baş
KEEPER_MIN_MARGIN_BPS=
# Priority fee: job'un yazılabilir hesaplarının son ücretlerinin yüzdeliği (0-100) ve üst sınırı (mikro-lamport / CU)
KEEPER_PRIORITY_FEE_PERCENTILE=
KEEPER_MAX_COMPUTE_UNIT_PRICE=

# --- CCTP relayer (BE-26; isteğe bağlı, hepsi birlikte) ---
# Circle'ın Solana programları ve kaynak domain başına CCTP ALT'ı (virgülle domain:adres;
# scripts/deploy/networks/<ağ>.json, cctp). Verilmezse relayer çalışmaz.
KEEPER_CCTP_MESSAGE_TRANSMITTER=
KEEPER_CCTP_TOKEN_MESSENGER_MINTER=
KEEPER_CCTP_LOOKUP_TABLES=
# Circle'ın attestation servisi (https)
KEEPER_CCTP_ATTESTATION_URL=
# Kurumun mint + fonlama tx'i için beklenen süre; dolunca relayer mesajı kendisi teslim eder
KEEPER_CCTP_RELAY_AFTER_SECONDS=
# Attestation ve fonlama yoklamasının geri çekilmesi: ilk aralık, her tekrarda ikiye katlanır, üst sınır
KEEPER_CCTP_BACKOFF_BASE_SECONDS=
KEEPER_CCTP_BACKOFF_MAX_SECONDS=

# --- Alarmlar (zorunlu) ---
KEEPER_ALERT_MIN_BALANCE_LAMPORTS=
KEEPER_ALERT_STALL_SECONDS=
KEEPER_ALERT_DUE_SECONDS=
KEEPER_ALERT_ERRORS=
KEEPER_ALERT_ERROR_WINDOW_SECONDS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
