{
  "name": "@squaresdk/solana-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Permissionless finalize crank: challenge'ı biten job'ları zincirde doğrular, kârlılık eşiği ve priority fee ile finalize eder; ProofRequired ve temiz olmayan screening'de geri çekilerek bekler, kararları keeper_actions günlüğüne yazar (BE-15); CCTP relayer'ı: attestation takibi, gerekirse Solana'da teslim, fonlamanın izlenmesi (BE-26)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-cctp": "workspace:*",
    "@squaresdk/solana-db": "workspace:*",
    "@squaresdk/solana-hardening": "workspace:*",
    "@squaresdk/solana-observability": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
