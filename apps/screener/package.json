{
  "name": "@squaresdk/solana-screener",
  "version": "0.1.0",
  "private": true,
  "description": "Sanctions screening servisi: OFAC SDN listesi ve sağlayıcı API'si (Chainalysis) ile tarama, screener authority anahtarıyla registry `record_screening` tx'i, TTL yenileme, denetim kaydı ve API (BE-16)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/web3.js": "^1.99.0",
    "@squaresdk/solana-db": "workspace:*",
    "@squaresdk/solana-hardening": "workspace:*",
    "@squaresdk/solana-observability": "workspace:*",
    "@squaresdk/solana-sdk": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@squaresdk/solana-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
