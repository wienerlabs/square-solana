# screener ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Program kimlikleri ortamdan değil,
# veritabanının `programs` tablosundan okunur (db paketinin seed'i, SQUARE_PROGRAM_ID_*).
# Gizli değerler (authority anahtarı, Chainalysis anahtarı) bu dosyaya ve repoya yazılmaz; secret
# store'dan gelir (README "Anahtar saklama").

# --- Veritabanı (zorunlu) ---
DATABASE_URL=

# --- Sunucu (zorunlu) ---
# API, /health ve /ready
SCREENER_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (SCREENER_PORT'tan farklı)
SCREENER_METRICS_PORT=
# İzinli API anahtarlarının SHA-256'sı (64 küçük harf hex, virgülle): printf %s "$ANAHTAR" | shasum -a 256
SCREENER_API_KEY_SHA256=
SCREENER_JSON_MAX_BYTES=
SCREENER_RATE_LIMIT_WINDOW_SECONDS=
# Pencere başına tarama (her biri bir tx) ve okuma isteği, anahtar başına
SCREENER_RATE_LIMIT_SCREEN=
SCREENER_RATE_LIMIT_READ=

# --- Solana RPC ve tx (zorunlu) ---
# Virgülle ayrılmış http(s) uçları; ilki tercih edilir, hata veren uç SCREENER_RPC_COOLDOWN_MS boyunca atlanır
SCREENER_RPC_URLS=
SCREENER_RPC_TIMEOUT_MS=
SCREENER_RPC_COOLDOWN_MS=
# Priority fee (mikro-lamport / CU)
SCREENER_COMPUTE_UNIT_PRICE=
SCREENER_CONFIRM_POLL_MS=

# --- Screener authority anahtarı (yalnızca biri, zorunlu; SECRET) ---
# solana-keygen JSON'u (64 baytlık dizi). Değer secret store'dan enjekte edilir.
SCREENER_AUTHORITY_KEYPAIR=
# ya da bağlanan secret dosyasının yolu (izin 600), ör. /run/secrets/screener-authority.json
SCREENER_AUTHORITY_KEYPAIR_PATH=

# --- OFAC SDN listesi (zorunlu) ---
# ör. https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
SCREENER_OFAC_SDN_URL=
SCREENER_OFAC_REFRESH_SECONDS=
# Son başarılı indirmenin üstünden bu kadar saniye geçerse tarama yapılmaz (REFRESH'ten büyük)
SCREENER_OFAC_MAX_AGE_SECONDS=
SCREENER_OFAC_TIMEOUT_MS=
SCREENER_OFAC_MAX_BYTES=

# --- Chainalysis sanctions API (isteğe bağlı, ADR 0020; anahtar SECRET) ---
# Boşsa yalnızca OFAC listesi taranır. Anahtar verilince URL ve süre zorunlu.
SCREENER_CHAINALYSIS_API_KEY=
# ör. https://public.chainalysis.com
SCREENER_CHAINALYSIS_URL=
SCREENER_CHAINALYSIS_TIMEOUT_MS=

# --- TTL yenileme (zorunlu) ---
SCREENER_RENEW_INTERVAL_SECONDS=
# expires_at'a bu kadar saniye kalan kayıt yeniden taranır (zincirdeki screening_ttl_secs'ten küçük)
SCREENER_RENEW_MARGIN_SECONDS=
SCREENER_RENEW_BATCH=
SCREENER_RENEW_RETRY_SECONDS=

# --- Alarmlar (zorunlu) ---
SCREENER_ALERT_ERRORS=
SCREENER_ALERT_ERROR_WINDOW_SECONDS=
SCREENER_ALERT_MIN_BALANCE_LAMPORTS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
