# compliance-api ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve
# açılışta doğrulanır (src/config.ts); eksik ya da geçersiz zorunlu değer süreci durdurur.

# --- Sunucu (zorunlu) ---
COMPLIANCE_API_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (COMPLIANCE_API_PORT'tan farklı)
COMPLIANCE_METRICS_PORT=
# development | test | production
NODE_ENV=
# debug | info | warn | error
LOG_LEVEL=
# Virgülle ayrılmış izinli origin URL'leri (en az bir tane)
CORS_ORIGINS=

# --- PostgreSQL (zorunlu) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Solana (zorunlu) ---
SOLANA_RPC_URL=
# square-verifier program kimliği
VERIFIER_PROGRAM=

# --- x402 (zorunlu; @squaresdk/solana-x402, BE-24) ---
# CAIP-2 kimliği ya da v1 adı: solana | solana-devnet (CAIP-2'ye çevrilir)
X402_NETWORK=
X402_PAYMENT_MINT=
X402_PUBLISHER_WALLET=
# /api/v1/compliance/protected-report fiyatı (ödeme mint'inin taban birimi)
X402_REPORT_PRICE=
# Square'in tek veritabanı (db/): ödeme yüklerinin tekrar korumaları `replay_guards` tablosunda
DATABASE_URL=
# Uzlaştırılmış raporun aynı ödeme kimliğiyle tekrar istenince ücretsiz döndüğü süre (saniye; `idempotency_records`)
X402_IDEMPOTENCY_TTL_SECONDS=

# --- x402 facilitator (ADR 0018) ---
# Boşsa kendi facilitator'ımız: işlem ücretini aşağıdaki cüzdan öder, SOLANA_RPC_URL ile doğrular ve gönderir.
# Yalnızca SOL tutan, X402_PUBLISHER_WALLET'tan ayrı 64 baytlık keypair (base58 ya da JSON dizi)
X402_FEE_PAYER_KEYPAIR=
# Doluysa harici x402 facilitator'ı (…/verify, …/settle, …/supported) ve isteğe bağlı bearer belirteci
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=

# --- Kayıtsız ödeme izleyicisi ---
# İsteğe bağlı: tanımlıysa izleyici çalışır ve HELIUS_API_URL zorunludur
HELIUS_API_KEY=
HELIUS_API_URL=
# Zorunlu (ms; en az 5000)
COMPLIANCE_WATCHER_INTERVAL_MS=
# İsteğe bağlı: virgülle ayrılmış mint listesi; tanımlı değilse tüm SPL transferleri izlenir
COMPLIANCE_WATCHER_MINTS=

# --- Gözlemlenebilirlik (@squaresdk/solana-observability) ---
# Zorunlu: tek bir hazırlık denetiminin süre sınırı (ms)
HEALTH_CHECK_TIMEOUT_MS=
# Zorunlu: alarm kurallarının değerlendirilme aralığı (saniye)
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı: alarm olaylarının gönderileceği JSON ucu; tanımlıysa ALERT_WEBHOOK_TIMEOUT_MS zorunludur
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
# Zorunlu: compliance_errors alarmı (penceredeki hata log'u sayısı eşiği ve pencere, saniye)
COMPLIANCE_ALERT_ERRORS=
COMPLIANCE_ALERT_ERROR_WINDOW_SECONDS=
# Zorunlu: compliance_database_down alarmı (veritabanı bu kadar saniye yanıt vermezse)
COMPLIANCE_ALERT_DB_DOWN_SECONDS=
