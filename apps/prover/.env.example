# prover ortam değişkenleri. Değerler bilerek boş: her değer dağıtıma özeldir ve açılışta doğrulanır
# (src/config.ts); eksik ya da geçersiz değer süreci durdurur. Docker imajı artefakt yollarını
# (PROVER_*_PATH) kendisi verir.

# --- Sunucu (zorunlu) ---
PROVER_SERVICE_PORT=
# Yalnızca iç ağdan erişilen /metrics portu (PROVER_SERVICE_PORT'tan farklı)
PROVER_METRICS_PORT=
# Virgülle ayrılmış izinli origin'ler
CORS_ORIGINS=

# --- Yetki (zorunlu) ---
# İzinli API anahtarlarının SHA-256'sı (64 küçük harf hex, virgülle); anahtarın kendisi ortamda tutulmaz
PROVER_API_KEY_SHA256=

# --- Kuyruk (zorunlu) ---
# Aynı anda üretilen en fazla ispat; sırada bekleyebilecek en fazla istek (dolunca 503); bekleme sınırı (ms)
PROVER_MAX_CONCURRENT=
PROVER_MAX_QUEUE=
PROVER_QUEUE_TIMEOUT_MS=

# --- Devre artefaktları (zorunlu) ---
# circuits/payment-compliance/artifacts/manifest.json; wasm ve zkey'in SHA-256'ları açılışta bununla karşılaştırılır
PROVER_MANIFEST_PATH=
PROVER_WASM_PATH=
PROVER_ZKEY_PATH=

# --- Alarmlar (zorunlu) ---
# prover_queue_backlog: sıradaki istek PROVER_ALERT_QUEUE_DEPTH'in üstünde PROVER_ALERT_QUEUE_SECONDS kalırsa
PROVER_ALERT_QUEUE_DEPTH=
PROVER_ALERT_QUEUE_SECONDS=
# prover_failures: iç hatayla biten ispat PROVER_ALERT_FAILURE_WINDOW_SECONDS içinde PROVER_ALERT_FAILURES'ı aşarsa
PROVER_ALERT_FAILURES=
PROVER_ALERT_FAILURE_WINDOW_SECONDS=

# --- Gözlemlenebilirlik (servislerde ortak, zorunlu) ---
# debug | info | warn | error
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_MS=
ALERT_EVALUATION_SECONDS=
# İsteğe bağlı JSON alarm ucu; verilirse ALERT_WEBHOOK_TIMEOUT_MS zorunlu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=
