{
  "name": "@squaresdk/solana-prover",
  "version": "0.1.0",
  "private": true,
  "description": "Groth16 prover servisi: release devresi (circuits/payment-compliance) için POST /v1/prove; artefakt sürümü denetimi, eşzamanlılık sınırı, health, Prometheus metrikleri ve alarmlar (BE-11, BE-12)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@squaresdk/solana-observability": "workspace:*",
    "@squaresdk/solana-policy": "workspace:*",
    "@squaresdk/solana-types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "snarkjs": "0.7.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@squaresdk/solana-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
